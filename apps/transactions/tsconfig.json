{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "resolvePackageJsonExports": true,
    "isolatedModules": true,
    "removeComments": true,
    "types": ["node", "jest"]
  },
  "include": ["src"]
}

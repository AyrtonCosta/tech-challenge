generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum TransactionStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("transaction_status")
}

model TransactionType {
  id   Int    @id
  name String @unique

  transactions Transaction[]

  @@map("transaction_types")
}

model Transaction {
  id                      String            @id @default(uuid(7)) @db.Uuid
  accountExternalIdDebit  String            @map("account_external_id_debit") @db.Uuid
  accountExternalIdCredit String            @map("account_external_id_credit") @db.Uuid
  transferTypeId          Int               @map("transfer_type_id")
  value                   Decimal           @db.Decimal(18, 2)
  status                  TransactionStatus @default(PENDING)
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  transactionType TransactionType @relation(fields: [transferTypeId], references: [id])
  outboxMessages  OutboxMessage[]

  @@index([status, createdAt(sort: Desc)])
  @@index([transferTypeId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("transactions")
}

model OutboxMessage {
  id            String    @id @default(uuid(7)) @db.Uuid
  topic         String
  key           String
  payload       Json
  published     Boolean   @default(false)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  transactionId String    @map("transaction_id") @db.Uuid

  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@index([published, createdAt])
  @@map("outbox_messages")
}
